        <bpmndi:BPMNLabel>
          <dc:Bounds x="146" y="1609" width="230" height="56" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bpmn-fulfillment_shape_p_timer" bpmnElement="p_timer">
        <dc:Bounds x="708" y="1560" width="44" height="44" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="616" y="1609" width="230" height="56" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bpmn-fulfillment_shape_p_failure" bpmnElement="p_failure">
        <dc:Bounds x="1178" y="1560" width="44" height="44" />
