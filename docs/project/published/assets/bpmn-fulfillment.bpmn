<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="bpmn-fulfillment_defs" targetNamespace="https://restaurant.example/analysis">
  <bpmn:process id="bpmn-fulfillment" name="Приготовление и выдача заказа" isExecutable="false">
    <bpmn:documentation>Аналитическая схема. Роль указана в названии задачи; дорожки не выделены. Правила A-xx применяются в границах проектных допущений. Это не исполняемая интеграционная модель.</bpmn:documentation>
    <bpmn:startEvent id="p_start" name="Заказ оплачен">
      <bpmn:outgoing>Flow_bpmn-fulfillment_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="p_send" name="Система: передать заказ; после приема показать «Готовится»">
      <bpmn:incoming>Flow_bpmn-fulfillment_0</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p_cook" name="Роботы: приготовить заказ">
      <bpmn:incoming>Flow_bpmn-fulfillment_1</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="p_ok" name="Основной робот справился?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_bpmn-fulfillment_2</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn-fulfillment_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="p_reserve" name="Роботы: передать резервному роботу">
      <bpmn:incoming>Flow_bpmn-fulfillment_4</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="p_resok" name="Резервный робот справился?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_bpmn-fulfillment_5</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn-fulfillment_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="p_cell" name="Роботы: разместить еду в ячейке">
      <bpmn:incoming>Flow_bpmn-fulfillment_3</bpmn:incoming>
      <bpmn:incoming>Flow_bpmn-fulfillment_6</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="p_cellok" name="Выдача доступна?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_bpmn-fulfillment_8</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn-fulfillment_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="p_ready" name="Система: показать «Готов» и номер ячейки">
      <bpmn:incoming>Flow_bpmn-fulfillment_9</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="p_wait" name="Ожидать событие выдачи">
      <bpmn:incoming>Flow_bpmn-fulfillment_11</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn-fulfillment_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn-fulfillment_14</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="p_open" name="После талона: дверь закрыта, вес стабилен, ячейка пуста (A-02)">
      <bpmn:incoming>Flow_bpmn-fulfillment_12</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_15</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="p_open_def">
        <bpmn:condition>После талона: дверь закрыта, вес стабилен, ячейка пуста (A-02)</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="p_timer" name="Истекли 10 минут (A-04)">
      <bpmn:incoming>Flow_bpmn-fulfillment_13</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_18</bpmn:outgoing>
      <bpmn:timerEventDefinition id="p_timer_def">
        <bpmn:timeDuration>PT10M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="p_failure" name="Сбой выдачи или контроля веса">
      <bpmn:incoming>Flow_bpmn-fulfillment_14</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_21</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="p_failure_def">
        <bpmn:condition>Сбой выдачи или контроля веса</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="p_issued" name="Система: «Выдан», снять номер (A-02)">
      <bpmn:incoming>Flow_bpmn-fulfillment_15</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p_expirenotify" name="Система: снять номер, блокировать выдачу, уведомить сотрудника">
      <bpmn:incoming>Flow_bpmn-fulfillment_18</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p_clean" name="Сотрудник: убрать еду; система: подтвердить пустоту (A-04)">
      <bpmn:incoming>Flow_bpmn-fulfillment_19</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p_verify" name="Система: освободить исправную пустую ячейку">
      <bpmn:incoming>Flow_bpmn-fulfillment_16</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="p_end" name="Выдача и свободная ячейка зарегистрированы">
      <bpmn:incoming>Flow_bpmn-fulfillment_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="p_expired" name="Неявка; место освобождено">
      <bpmn:incoming>Flow_bpmn-fulfillment_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="p_problem" name="Система: «Проблема», скрыть номер, уведомить менеджера">
      <bpmn:incoming>Flow_bpmn-fulfillment_7</bpmn:incoming>
      <bpmn:incoming>Flow_bpmn-fulfillment_10</bpmn:incoming>
      <bpmn:incoming>Flow_bpmn-fulfillment_21</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p_manager" name="Менеджер: принять заказ в ручной разбор (A-03)">
      <bpmn:incoming>Flow_bpmn-fulfillment_22</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn-fulfillment_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="p_manualend" name="Продолжение по регламенту">
      <bpmn:incoming>Flow_bpmn-fulfillment_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_0" sourceRef="p_start" targetRef="p_send" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_1" sourceRef="p_send" targetRef="p_cook" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_2" sourceRef="p_cook" targetRef="p_ok" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_3" sourceRef="p_ok" targetRef="p_cell" name="Да" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_4" sourceRef="p_ok" targetRef="p_reserve" name="Нет" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_5" sourceRef="p_reserve" targetRef="p_resok" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_6" sourceRef="p_resok" targetRef="p_cell" name="Да" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_7" sourceRef="p_resok" targetRef="p_problem" name="Нет" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_8" sourceRef="p_cell" targetRef="p_cellok" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_9" sourceRef="p_cellok" targetRef="p_ready" name="Да" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_10" sourceRef="p_cellok" targetRef="p_problem" name="Нет" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_11" sourceRef="p_ready" targetRef="p_wait" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_12" sourceRef="p_wait" targetRef="p_open" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_13" sourceRef="p_wait" targetRef="p_timer" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_14" sourceRef="p_wait" targetRef="p_failure" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_15" sourceRef="p_open" targetRef="p_issued" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_16" sourceRef="p_issued" targetRef="p_verify" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_17" sourceRef="p_verify" targetRef="p_end" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_18" sourceRef="p_timer" targetRef="p_expirenotify" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_19" sourceRef="p_expirenotify" targetRef="p_clean" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_20" sourceRef="p_clean" targetRef="p_expired" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_21" sourceRef="p_failure" targetRef="p_problem" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_22" sourceRef="p_problem" targetRef="p_manager" />
    <bpmn:sequenceFlow id="Flow_bpmn-fulfillment_23" sourceRef="p_manager" targetRef="p_manualend" />
  </bpmn:process>
