      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bpmn-fulfillment_shape_p_wait" bpmnElement="p_wait">
        <dc:Bounds x="228" y="1390" width="64" height="64" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="158" y="1346" width="210" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bpmn-fulfillment_shape_p_open" bpmnElement="p_open">
